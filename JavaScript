/*
  JAMTRAC Expenses Module
  Internal project cost and expense operations.
*/

import {
  getRecords,
  createRecord,
  updateRecord,
  deleteRecord
} from "../data/data-service.js";


export const EXPENSE_CATEGORIES = [
  "Materials",
  "Labor",
  "Equipment",
  "Transportation",
  "Permits / Fees",
  "Professional Services",
  "Other"
];


export async function getExpenses() {
  return await getRecords("expenses");
}


export async function createExpense(expenseData) {
  const description = String(
    expenseData.description || ""
  ).trim();

  const amount = Number(expenseData.amount);

  if (!description) {
    throw new Error(
      "Expense description is required."
    );
  }

  if (!Number.isFinite(amount) || amount < 0) {
    throw new Error(
      "Expense amount must be a valid positive amount."
    );
  }

  const category =
    EXPENSE_CATEGORIES.includes(expenseData.category)
      ? expenseData.category
      : "Other";

  return await createRecord("expenses", {
    description,
    amount,
    category,

    projectId:
      expenseData.projectId || null,

    receiptReference:
      expenseData.receiptReference || null,

    expenseDate:
      expenseData.expenseDate || null,

    status:
      expenseData.status || "recorded"
  });
}


export async function updateExpense(
  expenseId,
  updates
) {
  const safeUpdates = {
    ...updates
  };

  delete safeUpdates.id;
  delete safeUpdates.createdAt;

  if (
    safeUpdates.category &&
    !EXPENSE_CATEGORIES.includes(
      safeUpdates.category
    )
  ) {
    safeUpdates.category = "Other";
  }

  if (safeUpdates.amount !== undefined) {
    const amount = Number(safeUpdates.amount);

    if (!Number.isFinite(amount) || amount < 0) {
      throw new Error(
        "Expense amount must be valid."
      );
    }

    safeUpdates.amount = amount;
  }

  return await updateRecord(
    "expenses",
    expenseId,
    safeUpdates
  );
}


export async function removeExpense(expenseId) {
  return await deleteRecord(
    "expenses",
    expenseId
  );
}


export async function getProjectExpenses(
  projectId
) {
  const expenses = await getExpenses();

  return expenses.filter(
    (expense) =>
      expense.projectId === projectId
  );
}


export async function getProjectExpenseTotal(
  projectId
) {
  const expenses =
    await getProjectExpenses(projectId);

  return expenses.reduce(
    (total, expense) =>
      total + Number(expense.amount || 0),
    0
  );
}


export async function getTotalExpenses() {
  const expenses = await getExpenses();

  return expenses.reduce(
    (total, expense) =>
      total + Number(expense.amount || 0),
    0
  );
}