/*
  JAMTRAC Documents Module
  Document records, classifications, and status stamps.

  Actual server uploads are NOT enabled yet.
*/

import {
  getRecords,
  createRecord,
  updateRecord,
  deleteRecord
} from "../data/data-service.js";


export const DOCUMENT_TYPES = [
  "Assessment",
  "Estimate",
  "Work Order",
  "Invoice",
  "Receipt",
  "Photo",
  "Contract",
  "Other"
];


export const DOCUMENT_STAMPS = [
  "RECEIVED",
  "APPROVED",
  "PAID",
  "COMPLETED"
];


export async function getDocuments() {
  return await getRecords("documents");
}


export async function createDocumentRecord(
  documentData
) {
  const name = String(
    documentData.name || ""
  ).trim();

  if (!name) {
    throw new Error(
      "Document name is required."
    );
  }

  const type =
    DOCUMENT_TYPES.includes(documentData.type)
      ? documentData.type
      : "Other";

  return await createRecord("documents", {
    name,
    type,

    projectId:
      documentData.projectId || null,

    fileReference:
      documentData.fileReference || null,

    stamp: null,

    uploadStatus:
      "local-record-only",

    notes: String(
      documentData.notes || ""
    ).trim()
  });
}


export async function applyDocumentStamp(
  documentId,
  stamp
) {
  if (!DOCUMENT_STAMPS.includes(stamp)) {
    throw new Error(
      "Invalid JAMTRAC document stamp."
    );
  }

  return await updateRecord(
    "documents",
    documentId,
    {
      stamp,
      stampedAt: new Date().toISOString()
    }
  );
}


export async function clearDocumentStamp(
  documentId
) {
  return await updateRecord(
    "documents",
    documentId,
    {
      stamp: null,
      stampedAt: null
    }
  );
}


export async function updateDocument(
  documentId,
  updates
) {
  const safeUpdates = {
    ...updates
  };

  delete safeUpdates.id;
  delete safeUpdates.createdAt;

  if (
    safeUpdates.type &&
    !DOCUMENT_TYPES.includes(safeUpdates.type)
  ) {
    safeUpdates.type = "Other";
  }

  if (
    safeUpdates.stamp &&
    !DOCUMENT_STAMPS.includes(safeUpdates.stamp)
  ) {
    delete safeUpdates.stamp;
  }

  return await updateRecord(
    "documents",
    documentId,
    safeUpdates
  );
}


export async function removeDocument(
  documentId
) {
  return await deleteRecord(
    "documents",
    documentId
  );
}


export async function getProjectDocuments(
  projectId
) {
  const documents =
    await getDocuments();

  return documents.filter(
    (document) =>
      document.projectId === projectId
  );
}


export function describeLocalFile(file) {
  if (!file) {
    return null;
  }

  return {
    name: file.name,
    type: file.type || "unknown",
    size: file.size,
    lastModified: file.lastModified,

    uploaded: false,

    message:
      "Selected locally. This file has not been uploaded."
  };
}